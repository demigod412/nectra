# Copy to .env and adjust. Everything is optional for local development.

# --- server ---
PORT=3000
HOST=127.0.0.1              # 0.0.0.0 behind a reverse proxy / in Docker
PUBLIC_URL=http://localhost:3000
TRUST_PROXY=0               # 1 behind nginx/Cloudflare
COOKIE_SECURE=0             # 1 when served over HTTPS (required for push + wallets in production)
LOG_REQUESTS=0

# --- secrets (PRODUCTION: set these from a secrets manager and back them up) ---
# 64 hex chars. Encrypts collector keys, live-bot wallet keys and VAPID keys.
# Losing it = losing access to every encrypted key. Dev: auto-generated in data/master.key
# MASTER_KEY=
# Optional: bring your own collector keys instead of generated ones
# SOLANA_COLLECTOR_SECRET=   # base58 secret key
# EVM_COLLECTOR_KEY=         # 0x… private key
# TRON_COLLECTOR_KEY=        # hex private key

# --- first-run accounts (only when the database is empty) ---
ADMIN_EMAIL=admin@nectra.local
# ADMIN_PASSWORD=            # super admin (random if omitted; printed + saved to data/first-run-credentials.txt)
# ADMIN2_PASSWORD=           # ops@nectra.local (admin, second approver)
# OFFICER_PASSWORD=          # officer@nectra.local (loan officer)
DEMO_PASSWORD=Demo-Trader-2026

# --- demo mode (codes on screen, demo wallets, simulated chain actions). 0 in production ---
DEMO_MODE=1

# --- AI Copilot (Claude). Without a key the rule-based parser is used ---
# ANTHROPIC_API_KEY=
# COPILOT_MODEL=claude-opus-5-5

# --- market data ---
# PRICE_FEED=sim             # force the simulated feed
# PYTH_API_KEY=              # use Pyth Hermes (public Hermes now requires a key); otherwise Jupiter + CoinGecko
# COINGECKO_API_KEY=         # demo/pro key raises rate limits (prices, candles)
# CANDLES_API=https://data-api.binance.vision/api/v3/klines

# --- Solana ---
SOLANA_RPC=https://api.mainnet-beta.solana.com   # use a dedicated RPC (Helius, Triton, QuickNode…) in production
SOLANA_CLUSTER=mainnet-beta
# JUPITER_API=https://lite-api.jup.ag/swap/v1

# --- EVM (defaults to public RPCs; set your own for reliability) ---
# RPC_ETHEREUM=
# RPC_BASE=
# RPC_ARBITRUM=
# RPC_BSC=
# RPC_POLYGON=

# --- Tron ---
# TRON_RPC=https://api.trongrid.io
# TRON_API_KEY=

# --- BTC / LTC collateral escrow (account-level xpub/zpub from wallets YOU control; server can only watch) ---
# BTC_COLLATERAL_XPUB=
# LTC_COLLATERAL_XPUB=
# BTC_ESPLORA=https://blockstream.info/api
# LTC_ESPLORA=https://litecoinspace.org/api

# --- web push (auto-generated VAPID keys if omitted) ---
# VAPID_SUBJECT=mailto:you@yourdomain.com
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# --- email (without SMTP, mail goes to Admin → Mailbox and the console) ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=NECTRA <no-reply@yourdomain.com>

# DB_PATH=./data/nectra.db
