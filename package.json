{
  "name": "nectra-platform",
  "version": "2.0.0",
  "private": true,
  "description": "NECTRA — AI trading platform: Claude Copilot, paper + live (Jupiter) bots, multi-chain wallet-verified loans with collection approvals, admin console with roles and two-admin approvals, PWA + push.",
  "main": "server/index.js",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch server/index.js",
    "reset": "node -e \"require('fs').rmSync('data',{recursive:true,force:true});console.log('data/ wiped — restart to reseed')\"",
    "test": "node --disable-warning=ExperimentalWarning test/smoke.js",
    "test:unit": "node --test \"test/*.test.js\"",
    "test:all": "npm run test:unit && npm test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@bitcoinerlab/secp256k1": "^2.0.0",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^3.1.1",
    "bip32": "^5.0.1",
    "bitcoinjs-lib": "^7.0.5",
    "bs58": "^6.0.0",
    "tronweb": "^6.5.1",
    "viem": "^2.57.16",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  }
}
